<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_alnoor" model="ir.ui.view">
        <field name="name">sale.order.form.alnoor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_request_approval"
                        string="Request Credit Approval"
                        type="object"
                        class="btn-warning"
                        invisible="state not in ('draft', 'sent') or not is_credit_limit_exceeded or approval_status in ('pending', 'approved')"/>
                <button name="action_approve_credit_limit"
                        string="Approve Credit Exception"
                        type="object"
                        class="btn-success"
                        invisible="approval_status != 'pending'"
                        groups="alnoor_custom.group_credit_limit_approver,sales_team.group_sale_manager"/>
                <button name="action_reject_credit_limit"
                        string="Reject Order"
                        type="object"
                        class="btn-danger"
                        invisible="approval_status != 'pending'"
                        groups="alnoor_custom.group_credit_limit_approver,sales_team.group_sale_manager"/>
            </xpath>

            <!-- Alerts for Approval Status -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="approval_status != 'pending'">
                    <strong>Waiting for Approval:</strong> This order exceeds customer credit limit and is pending review by the Sales Manager or General Manager.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="approval_status != 'rejected'">
                    <strong>Order Rejected:</strong> Reason: <field name="rejection_reason" readonly="1" class="d-inline"/>. Please adjust terms or request approval again.
                </div>
                <div class="alert alert-success mb-0" role="alert" invisible="approval_status != 'approved'">
                    <strong>Credit Exception Approved:</strong> Approved by <field name="approved_by_id" readonly="1" class="d-inline"/> on <field name="approval_date" readonly="1" class="d-inline"/>.
                </div>
            </xpath>

            <!-- Credit & Approval Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Credit &amp; Approvals" name="credit_approval">
                    <group>
                        <group string="Credit Limit Status">
                            <field name="is_credit_limit_exceeded" readonly="1"/>
                            <field name="partner_credit_limit" readonly="1"/>
                            <field name="credit_limit_difference" readonly="1" invisible="not is_credit_limit_exceeded"/>
                            <field name="approval_status" widget="badge"
                                   decoration-warning="approval_status == 'pending'"
                                   decoration-success="approval_status == 'approved'"
                                   decoration-danger="approval_status == 'rejected'"/>
                        </group>
                        <group string="Approval &amp; Audit Trail">
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="approval_notes"/>
                            <field name="rejected_by_id" readonly="1" invisible="approval_status != 'rejected'"/>
                            <field name="rejection_date" readonly="1" invisible="approval_status != 'rejected'"/>
                            <field name="rejection_reason" readonly="1" invisible="approval_status != 'rejected'"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_alnoor" model="ir.ui.view">
        <field name="name">sale.order.list.select.alnoor</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter string="Waiting Approval" name="filter_pending_approval" domain="[('approval_status', '=', 'pending')]"/>
                <filter string="Credit Limit Exceeded" name="filter_credit_exceeded" domain="[('is_credit_limit_exceeded', '=', True)]"/>
                <filter string="Approved Orders" name="filter_approved" domain="[('approval_status', '=', 'approved')]"/>
                <filter string="High Value Orders" name="filter_high_value" domain="[('amount_total', '&gt;=', 50000)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Approval Status" name="group_approval_status" context="{'group_by': 'approval_status'}"/>
                <filter string="Customer Type" name="group_customer_type" context="{'group_by': 'customer_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
