<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_alnoor" model="ir.ui.view">
        <field name="name">purchase.order.form.alnoor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Alert Banner for To Approve state -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'to approve'">
                    <strong>Manager Approval Required:</strong> This purchase order total is greater than or equal to 50,000 SAR and can only be confirmed by the <b>Purchase Manager</b>.
                </div>
            </xpath>

            <!-- High Value Badge in Form Sheet -->
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="is_high_value_po" invisible="not is_high_value_po" widget="badge"
                       decoration-warning="state == 'to approve'"
                       decoration-success="state in ('purchase', 'done')"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_alnoor" model="ir.ui.view">
        <field name="name">purchase.order.select.alnoor</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_purchases']" position="after">
                <separator/>
                <filter string="High Value (>= 50k SAR)" name="filter_high_value_po" domain="[('amount_total', '&gt;=', 50000)]"/>
                <filter string="Waiting Manager Approval" name="filter_to_approve" domain="[('state', '=', 'to approve')]"/>
            </xpath>
        </field>
    </record>
</odoo>
